# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# settings.py loads it automatically when python-dotenv is installed.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-key-replace-me

# Must be False in production. True enables detailed error pages.
DJANGO_DEBUG=True

# Comma-separated hostnames. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:8000

# Comma-separated origins, needed for form POSTs served over HTTPS.
# e.g. https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Only consulted when DJANGO_DEBUG=False. Set False if TLS terminates at a
# proxy and you have not wired SECURE_PROXY_SSL_HEADER for your host.
DJANGO_SECURE_SSL_REDIRECT=True
